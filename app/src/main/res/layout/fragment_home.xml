<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:orientation="vertical"
    tools:context=".ui.HomeFragment">

    <!-- Placeholder layout for locking screen-->
    <FrameLayout
        android:id="@+id/lock"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:contentDescription="@string/lock_layout_description" />

    <!-- Smoky surface between wallpaper and home text -->
    <View
        android:id="@+id/homeScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/homeScrimColor"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Time (left) + monochrome weather (right) above the journal -->
    <LinearLayout
        android:id="@+id/dateTimeLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <TextClock
            android:id="@+id/clock"
            style="@style/TextDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textSize="@dimen/time_size"
            tools:text="02:34" />

        <!-- Kept for ViewBinding compatibility; date/battery no longer shown -->
        <TextView
            android:id="@+id/date"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/weather"
            style="@style/TextDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:gravity="end"
            android:maxLines="1"
            android:textSize="@dimen/date_size"
            android:visibility="gone"
            tools:text="72° Clear"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Screen time-->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvScreenTime"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="44dp"
        android:gravity="center"
        android:padding="10dp"
        android:textSize="@dimen/date_size"
        android:visibility="gone"
        tools:text="2h 11m"
        tools:visibility="visible" />

    <!-- Bullet journal pages: Monthly | Daily | Future -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/journalPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="140dp"
        android:clipToPadding="false" />

    <!-- Index collection page (Unscheduled / tag) overlays the pager -->
    <FrameLayout
        android:id="@+id/collectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="140dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- App drawer overlay (keeps bottom sheet visible for drag-and-drop) -->
    <FrameLayout
        android:id="@+id/appDrawerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/drawerBackgroundColor"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:visibility="gone" />

    <!-- Home apps bottom sheet: 5 columns × 3 rows -->
    <LinearLayout
        android:id="@+id/homeAppsBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:animateLayoutChanges="true"
        android:background="@drawable/bg_home_apps_bottom_sheet"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <FrameLayout
            android:id="@+id/homeAppsSheetHandleArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/expand_apps_sheet"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <View
                android:id="@+id/homeAppsSheetHandle"
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_bottom_sheet_handle" />
        </FrameLayout>

        <GridLayout
            android:id="@+id/homeAppsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignBounds"
            android:columnCount="5"
            android:paddingHorizontal="12dp"
            android:paddingBottom="8dp"
            android:rowCount="3"
            android:useDefaultMargins="false">

            <include
                android:id="@+id/homeApp1"
                layout="@layout/item_home_app"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal|center_vertical" />

            <include
                android:id="@+id/homeApp2"
                layout="@layout/item_home_app"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal|center_vertical" />

            <include
                android:id="@+id/homeApp3"
                layout="@layout/item_home_app"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal|center_vertical" />

            <include
                android:id="@+id/homeApp4"
                layout="@layout/item_home_app"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal|center_vertical" />

            <include
                android:id="@+id/homeApp5"
                layout="@layout/item_home_app"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal|center_vertical" />

            <include
                android:id="@+id/homeApp6"
                layout="@layout/item_home_app"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal|center_vertical" />

            <include
                android:id="@+id/homeApp7"
                layout="@layout/item_home_app"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal|center_vertical" />

            <include
                android:id="@+id/homeApp8"
                layout="@layout/item_home_app"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal|center_vertical" />

            <include
                android:id="@+id/homeApp9"
                layout="@layout/item_home_app"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal|center_vertical" />

            <include
                android:id="@+id/homeApp10"
                layout="@layout/item_home_app"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal|center_vertical" />

            <include
                android:id="@+id/homeApp11"
                layout="@layout/item_home_app"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal|center_vertical" />

            <include
                android:id="@+id/homeApp12"
                layout="@layout/item_home_app"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal|center_vertical" />

            <include
                android:id="@+id/homeApp13"
                layout="@layout/item_home_app"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal|center_vertical" />

            <include
                android:id="@+id/homeApp14"
                layout="@layout/item_home_app"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal|center_vertical" />

            <include
                android:id="@+id/homeApp15"
                layout="@layout/item_home_app"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal|center_vertical" />

        </GridLayout>
    </LinearLayout>

    <!-- Add bullet FAB — visible on all journal pages -->
    <ImageView
        android:id="@+id/addBulletButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="120dp"
        android:background="@drawable/bg_fab_add"
        android:contentDescription="@string/add_bullet"
        android:elevation="20dp"
        android:padding="14dp"
        android:src="@drawable/ic_add"
        android:tint="?attr/primaryColor" />

    <!-- Set default launcher -->
    <TextView
        android:id="@+id/setDefaultLauncher"
        style="@style/TextMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="260dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/set_as_default_launcher_u"
        android:visibility="gone" />
</FrameLayout>
