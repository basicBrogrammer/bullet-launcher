<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/dialogTitle"
        style="@style/TextSmallBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:letterSpacing="0.12"
        android:paddingBottom="8dp"
        android:text="@string/add_entry"
        android:textAllCaps="true" />

    <EditText
        android:id="@+id/entryInput"
        style="@style/TextMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:fontFamily="serif"
        android:hint="@string/entry_hint"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLines="4"
        android:paddingVertical="12dp" />

    <TextView
        style="@style/TextSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:text="@string/rapid_logging"
        android:textAllCaps="true" />

    <LinearLayout
        android:id="@+id/typeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/typeTask"
            style="@style/TextMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/bullet_task" />

        <TextView
            android:id="@+id/typeEvent"
            style="@style/TextMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/bullet_event" />

        <TextView
            android:id="@+id/typeNote"
            style="@style/TextMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/bullet_note" />
    </LinearLayout>

    <TextView
        android:id="@+id/calendarSyncHint"
        style="@style/TextSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:paddingBottom="4dp"
        android:text="@string/event_calendar_sync_hint"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/priorityToggle"
        style="@style/TextMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:paddingVertical="10dp"
        android:text="@string/priority_off" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/deleteButton"
            style="@style/TextMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="12dp"
            android:text="@string/delete_entry"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/cancelButton"
            style="@style/TextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/cancel" />

        <TextView
            android:id="@+id/saveButton"
            style="@style/TextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/save"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
